{
  "name": "@scalo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/migrate-cli.ts latest",
    "migrate:down": "tsx src/migrate-cli.ts down",
    "migrate:status": "tsx src/migrate-cli.ts status",
    "seed": "tsx src/seed.ts",
    "test": "NODE_ENV=test node --import tsx --test --test-concurrency=1 --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@scalo/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.17",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
