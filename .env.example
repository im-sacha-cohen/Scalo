# PostgreSQL (docker compose up -d db) — or any hosted Postgres (Supabase, Neon, RDS…)
DATABASE_URL=postgres://scalo:scalo_dev_password@localhost:5433/scalo
# Test database used by `npm test` (created automatically)
TEST_DATABASE_URL=postgres://scalo:scalo_dev_password@localhost:5433/scalo_test
# Signs sessions, contact cookies, unsubscribe & preview links. Use a long random value in production.
JWT_SECRET=change-me
API_PORT=4000
# Public base URL used in email links and images; also the OAuth issuer (iss) of the authorization server
PUBLIC_URL=http://localhost:5173

# --- Self-hosting with Docker (docker-compose.prod.yml, see docs/self-hosting.md) ---
# Fill in the three values: SCALO_DOMAIN and POSTGRES_PASSWORD below, and JWT_SECRET above
# (`./scripts/generate-secrets.sh --write` generates the secrets), then: docker compose -f docker-compose.prod.yml up -d
# DATABASE_URL, PUBLIC_URL (https://SCALO_DOMAIN), API_PORT, TRUST_PROXY and UPLOAD_DIR are set by the compose file.
# Domain of the application (its DNS A / AAAA record must point to the server; ports 80 and 443 open)
SCALO_DOMAIN=
# Password of the bundled PostgreSQL (letters and digits only; choose it before the first start)
POSTGRES_PASSWORD=
# ALLOW_SIGNUPS=false      # close public sign-ups once your account exists (the first account can always be created)

# Optional
# WEB_DIST=/path/to/web/dist  # built web app served by the API itself (default: web/dist when NODE_ENV=production; `false` = never)
# AUTO_MIGRATE=true        # apply pending migrations at API startup (default: true, false in production)
# DATABASE_POOL_MAX=10
# DATABASE_SSL=true        # or ?sslmode=require in DATABASE_URL
# NODE_ENV=production      # enforces a strong JWT_SECRET
# TRUST_PROXY=1           # behind a reverse proxy / load balancer: hop count, `true`, or subnets (default: off)
# APP_HOSTS=api.scalo.fr  # other host names of the app itself; any other host is only served if it is a verified custom domain
# CUSTOM_DOMAIN_TARGET=pages.scalo.fr  # CNAME target shown to users for their custom domains (default: host of PUBLIC_URL)
# AI (Claude API). "Bring your own key": set an instance-wide key here, or let each account store its own in Settings → IA
# ANTHROPIC_API_KEY=sk-ant-…
# AI_MODEL=claude-opus-5-5        # model used for generations
# AI_TIMEOUT_MS=180000            # hard deadline of one generation
# AI_RATE_LIMIT_PER_HOUR=30       # AI calls per account and hour
# ENCRYPTION_KEY=                 # encrypts secrets stored in the database (account AI keys); default: derived from JWT_SECRET
# Payments (Stripe): no instance variable. Each account enters its own Stripe keys in Paramètres → Paiements; they are
# stored encrypted with ENCRYPTION_KEY (or JWT_SECRET) — changing that secret means entering the Stripe keys again.
# Enterprise edition (optional, see ee/README.md) — the core runs without it
# SCALO_LICENSE_KEY=scalo_lic_…   # license key (or enter it in Paramètres → Licence); verified offline
# SCALO_DISABLE_EE=1              # ignore the ee/ directory even if present (community edition)

